{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PoC Anchoring Dataset Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "item_id", "suite", "subtype", "field", "domain",
    "template_id", "answer_space", "anchors", "gold", "prompts", "meta"
  ],
  "properties": {
    "item_id": { "type": "string", "pattern": "^[AB]-\\d{4}$" },
    "suite": { "type": "string", "enum": ["external", "self_generated"] },
    "subtype": { "type": "string" },
    "field": { "type": "string", "enum": ["health", "finance", "ops"] },
    "domain": { "type": "string" },
    "template_id": { "type": "string" },
    "answer_space": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "min", "max"],
      "properties": {
        "type": { "type": "string", "const": "int" },
        "min": { "type": "integer", "const": 0 },
        "max": { "type": "integer", "const": 100 }
      }
    },
    "anchors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "high", "controlled_history"],
      "properties": {
        "low": { "type": ["integer", "null"] },
        "high": { "type": ["integer", "null"] },
        "controlled_history": {
          "type": "array",
          "items": { "type": "integer" }
        }
      }
    },
    "gold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theta", "y_star", "y_star_stage1", "y_star_stage2"],
      "properties": {
        "theta": { "type": "integer", "minimum": 15, "maximum": 85 },
        "y_star": { "type": ["integer", "null"] },
        "y_star_stage1": { "type": ["integer", "null"] },
        "y_star_stage2": { "type": ["integer", "null"] }
      }
    },
    "prompts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control", "low_anchor", "high_anchor",
        "turn1", "turn2_fresh", "turn2_history",
        "turn2_controlled_history"
      ],
      "properties": {
        "control": { "type": ["string", "null"] },
        "low_anchor": { "type": ["string", "null"] },
        "high_anchor": { "type": ["string", "null"] },
        "turn1": { "type": ["string", "null"] },
        "turn2_fresh": { "type": ["string", "null"] },
        "turn2_history": { "type": ["string", "null"] },
        "turn2_controlled_history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["anchor", "prompt"],
            "properties": {
              "anchor": { "type": "integer" },
              "prompt": { "type": "string" }
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "version", "seed"],
      "properties": {
        "language": { "type": "string", "const": "en" },
        "version": { "type": "string" },
        "seed": { "type": "integer" }
      }
    }
  }
}
