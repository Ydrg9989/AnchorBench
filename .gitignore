# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environment / secrets
.env
.env.local

# IDE / editor
.cursor/
.codex/
.idea/
.vscode/
*.swp
*.swo

# Generated results (reproducible from datasets + scripts).
# NOTE: these are anchored with a leading "/" on purpose. Bare rules like
# "results/" or "figures/" match at ANY depth, which previously hid
# src/anchorbench/analysis/ and every COLM*/figures/ paper figure.
/outputs/
/logs/
/figures/

# results/ is ignored except the two small unified summaries, which
# `anchorbench verify` needs in order to run on a fresh clone. A plain
# negation cannot re-include a file underneath an excluded directory, so
# each level has to be re-opened explicitly.
/results/*
!/results/full_benchmark/
/results/full_benchmark/*
!/results/full_benchmark/unified_all_suites.json
!/results/api_benchmark/
/results/api_benchmark/*
!/results/api_benchmark/unified_all_suites.json
# ...and the small extension artifacts the full (non---quick) verifier reads:
# two aggregate CSVs plus 16 mitigation-headroom summaries, ~72 KB total.
# The bulky per-record and item-level files stay ignored.
!/results/revision/
/results/revision/*
!/results/revision/gold_shift_decomposition/
/results/revision/gold_shift_decomposition/*
!/results/revision/gold_shift_decomposition/gold_shift_aggregated.csv
!/results/revision/sampling_robustness/
/results/revision/sampling_robustness/*
!/results/revision/sampling_robustness/sampling_robustness_summary.csv
!/results/revision/mitigation_headroom/
/results/revision/mitigation_headroom/**/*
# re-open the intermediate directories *after* the exclusion above, or git
# never descends into them and the summary.json negation below never applies
!/results/revision/mitigation_headroom/**/
!/results/revision/mitigation_headroom/**/summary.json

# Archives and backups
*.zip
*.tar.gz
archive_*.tar.gz
*_pre_rerun_backup_*/

# Legacy top-level dirs (removed; available in git history)
/legacy/
/analysis/

# Upstream COLM template checkout — it carries its own nested .git, so
# adding it would record an unclonable gitlink. Everything in it is already
# present under COLM/.
/Template/

# LaTeX build artifacts (suffix rules, so they survive directory renames)
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.out
*.synctex
*.synctex.gz
*.synctex(busy)
pdflatex*.fls
COLM*/archive/

# LaTeX logs only — do not ignore *.log globally, run logs live elsewhere
COLM*/*.log
