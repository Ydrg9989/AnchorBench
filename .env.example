# AnchorBench environment variables
#
# Do NOT create a .env in the repo root. Keys inside the working tree get
# shipped by any folder upload or tarball. Copy this file to
# ~/.config/anchorbench/env instead:
#
#   mkdir -p ~/.config/anchorbench && chmod 700 ~/.config/anchorbench
#   cp .env.example ~/.config/anchorbench/env
#   chmod 600 ~/.config/anchorbench/env
#
# scripts/run_with_env.sh sources that file automatically. Override the
# location with ANCHORBENCH_ENV=/path/to/env.

# OpenRouter API key (required for API model evaluation)
export OPENROUTER_API_KEY=your-openrouter-key-here

# HuggingFace token (optional, for gated models like Llama).
# If unset, scripts/run_with_env.sh reads ~/.cache/huggingface/token
export HF_TOKEN=your-hf-token-here
