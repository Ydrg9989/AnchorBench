# AnchorBench environment variables
# Copy this file to .env and fill in your values.

# OpenRouter API key (required for API model evaluation)
OPENROUTER_API_KEY=your-openrouter-key-here

# HuggingFace token (optional, for gated models like Llama)
# If not set, scripts/run_with_env.sh reads from ~/.cache/huggingface/token
HF_TOKEN=your-hf-token-here
